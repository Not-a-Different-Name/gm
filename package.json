{
  "name": "gm",
  "version": "0.1.0",
  "private": true,
  "description": "可扩展的网页体素沙盒游戏",
  "packageManager": "pnpm@10.6.3",
  "scripts": {
    "dev": "corepack pnpm --filter @gm/web dev",
    "build": "corepack pnpm --recursive run build",
    "test": "corepack pnpm --recursive run test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "corepack pnpm --recursive run typecheck"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "@eslint/js": "^9.22.0",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0"
  }
}
